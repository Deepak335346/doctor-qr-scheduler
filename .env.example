# Clinic Application Environment Variables
PORT=5000
NODE_ENV=production

# JWT Authentication Secret (Change to a strong random key in production)
JWT_SECRET=super_secret_clinic_key_ind_2026_dr_apex

# Doctor Authentication Credentials
DOCTOR_USERNAME=doctor
DOCTOR_PASSWORD=Doctor@2026
DOCTOR_PIN=782104

# Rate Limiting & Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300

# Persistent Cloud Database (MongoDB Atlas)
# Recommended for cloud deployments (e.g. Render/Railway) for permanent persistence
# Free M0 cluster available at: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/clinic_scheduler?retryWrites=true&w=majority
